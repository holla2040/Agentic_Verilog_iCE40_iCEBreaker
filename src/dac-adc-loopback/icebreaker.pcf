# ============================================================================
# iCEBreaker Pin Constraints for DAC-ADC Loopback Project
# ============================================================================
#
# Phase 1: DAC pins only (PMOD DA2 on PMOD1A)
#
# PMOD1A Pinout (top row, left to right):
#   Pin 1 (P1A1) = FPGA Pin 4  -> SYNC
#   Pin 2 (P1A2) = FPGA Pin 2  -> DINA (channel A data)
#   Pin 3 (P1A3) = FPGA Pin 47 -> DINB (channel B data, unused)
#   Pin 4 (P1A4) = FPGA Pin 45 -> SCLK
#
# ============================================================================

# ----------------------------------------------------------------------------
# SYSTEM CLOCK
# ----------------------------------------------------------------------------
# 12 MHz oscillator on the iCEBreaker board
set_io clk 35

# ----------------------------------------------------------------------------
# DAC SPI INTERFACE (PMOD DA2 on PMOD1A)
# ----------------------------------------------------------------------------
# SYNC - Chip select, active LOW
set_io dac_sync_n 4

# DIN - Serial data input for DAC channel A
set_io dac_din 2

# SCLK - SPI clock
set_io dac_sclk 45

# ----------------------------------------------------------------------------
# ADC SPI INTERFACE (PMOD AD1 on PMOD1B)
# ----------------------------------------------------------------------------
# CS - Chip select, active LOW (triggers conversion on falling edge)
set_io adc_cs_n 43

# SDATA - Serial data FROM ADC (MISO)
set_io adc_sdata 38

# SCLK - SPI clock to ADC
set_io adc_sclk 31

# ----------------------------------------------------------------------------
# UART OUTPUT (to USB serial chip)
# ----------------------------------------------------------------------------
set_io uart_tx 9
